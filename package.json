{
  "name": "anchored",
  "version": "0.1.0",
  "private": true,
  "description": "Anchored helps any small business discover, compare and adopt AI tools, with approve-first agents where no tool fits.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "discover": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/discover.ts",
    "playbook:sql": "node --import tsx scripts/playbook-sql.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.70.0",
    "next": "^15.5.29",
    "qrcode": "1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
