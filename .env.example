# Copy to .env.local for local runs, and set the same keys in Vercel.
# Every key is optional for `npm run dev`. With none set, Anchored runs on an
# in-memory store and its own rules, with accounts off.

# --- Accounts (Supabase Auth) ---
# Set both to turn on sign-in: email magic links, Google, and Continue as guest.
# Next.js copies NEXT_PUBLIC_ values into the browser bundle at build time, so rebuild after changing them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Storage (Supabase Postgres) ---
# The service role key stays on the server; the browser never sees it.
# SUPABASE_URL is optional when NEXT_PUBLIC_SUPABASE_URL names the same project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# A production build without the store settings above throws. Set to 1 to run on
# the in-memory store anyway, for example to test `next start` on your machine.
ANCHORED_ALLOW_MEMORY_STORE=

# --- AI provider ---
# Leave these unset to run on Anchored's rules alone.
# Before a public deploy, set a hard spend cap in your AI provider's billing settings.
# One of: anthropic, openai, openrouter, featherless, openai-compatible.
AI_PROVIDER=
# The API key for that provider, whichever it is.
AI_API_KEY=
# Optional, except for openai-compatible: the endpoint root, before /chat/completions.
# Defaults: openai https://api.openai.com/v1, openrouter https://openrouter.ai/api/v1,
# featherless https://api.featherless.ai/v1, anthropic the Claude API.
# It must use https, except for a model on localhost.
AI_BASE_URL=
# The model for every tier. Every provider except anthropic needs it, unless all
# three tier variables below are set.
AI_MODEL=
# Optional: the model for one tier, overriding AI_MODEL.
AI_MODEL_QUICK=
AI_MODEL_DEFAULT=
AI_MODEL_COMPLEX=
# Model calls allowed per UTC day across every visitor, counted in Supabase. Default 2000; 0 turns AI calls off.
AI_DAILY_CALL_CAP=
# This deployment's public URL, sent to providers that ask for attribution, such as OpenRouter.
APP_URL=

# --- Connected services ---
# Each service stays off until its keys are set. See "Connect real services" in the README.
# 32 random bytes in base64 that encrypt connected credentials: openssl rand -base64 32
CONNECTOR_SECRET_KEY=
# Resend sends approved emails from a verified domain.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
# Postmark's inbound address, and the secret its webhook URL carries as ?key=.
INBOUND_EMAIL_ADDRESS=
INBOUND_EMAIL_SECRET=
# The bearer token GET /api/cron/dispatch requires before it sends queued messages.
CRON_SECRET=
# This deployment's public https address, where webhook URLs start.
PUBLIC_APP_URL=
# Set to 1 to let a guest connect services in a local run. Leave unset in production.
ANCHORED_ALLOW_GUEST_CONNECTIONS=

# --- Business lookup (Google Places) ---
# Turns on "Is this you?" in onboarding. Restrict the key to the Places API and set a daily quota.
GOOGLE_PLACES_API_KEY=
