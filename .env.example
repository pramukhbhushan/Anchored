# Copy to .env.local for local runs, and set the same keys in Vercel.
# Every key is optional for `npm run dev`. With none set, Anchored runs on an
# in-memory store and its own rules, with accounts off. AI keys are not set
# here: each owner adds their own on a business's Connections page.
# docs/deploy.md explains each key and the setup steps.

# --- Accounts (Supabase Auth) ---
# Set both to turn on sign-in: email magic links, Google, and Continue as guest.
# Next.js copies NEXT_PUBLIC_ values into the browser bundle at build time, so rebuild after changing them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Storage (Supabase Postgres) ---
# The service role key stays on the server; the browser never sees it.
# SUPABASE_URL is optional when NEXT_PUBLIC_SUPABASE_URL names the same project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# A production build without the store settings above throws. Set to 1 to run on
# the in-memory store anyway, for example to test `next start` on your machine.
ANCHORED_ALLOW_MEMORY_STORE=
# Set to 1 only behind a proxy that sets x-real-ip or replaces x-forwarded-for, so
# rate limits count per client IP. Vercel needs nothing: it sets VERCEL=1. Without
# either, a client could write those headers itself, so a request with a session
# counts under its session alone, and requests with none share one bucket.
TRUST_PROXY_HEADERS=

# --- Connected services ---
# Each service stays off until its keys are set. See "Connect real services" in docs/deploy.md.
# 32 random bytes in base64 that encrypt connected credentials: openssl rand -base64 32
CONNECTOR_SECRET_KEY=
# The bearer token GET /api/cron/dispatch and GET /api/cron/brief require.
CRON_SECRET=
# This deployment's public https address, where webhook URLs start. AI providers
# that ask for attribution, such as OpenRouter, get it too.
PUBLIC_APP_URL=
# Set to 1 to let a guest connect services in a local run. Leave unset in production.
ANCHORED_ALLOW_GUEST_CONNECTIONS=

# --- Telegram (optional, not verified in production) ---
# One shared bot for every business. It stays off until TELEGRAM_BOT_TOKEN is set.
# The token from BotFather. It stays on the server.
TELEGRAM_BOT_TOKEN=
# The bot's username, without the @.
TELEGRAM_BOT_USERNAME=
# A random string Telegram sends with each update. scripts/telegram-webhook.ts and
# the deployed app must use the same value.
TELEGRAM_WEBHOOK_SECRET=
