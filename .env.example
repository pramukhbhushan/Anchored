# Copy to .env.local for local runs, and set the same keys in Vercel.
# With none of these set, Anchored runs on an in-memory store and its own rules, so the demo still works.

# Supabase project URL and service role key. The service role key stays on the server; the browser never sees it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key for onboarding text and "Rewrite in my voice".
ANTHROPIC_API_KEY=
